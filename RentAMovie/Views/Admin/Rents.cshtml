@model IEnumerable<RentAMovie.Models.Rent>
@{
    ViewData["Title"] = "Manage Rents";
}

<div class="page-header">
    <h2>Manage Rents</h2>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-container">
    <table class="table">
        <thead>
            <tr>
                <th>User</th>
                <th>Movie</th>
                <th>From Date</th>
                <th>To Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rent in Model)
            {
                <tr>
                    <td>@rent.User?.Username</td>
                    <td>@rent.Movie?.Genre @rent.Movie?.Title</td>
                    <td>@rent.FromDate.ToString("dd/MM/yyyy")</td>
                    <td>@rent.ToDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (rent.ToDate >= DateTime.Today)
                        {
                            <span class="badge" style="background-color: var(--success-color); color: white; padding: 0.25rem 0.5rem; border-radius: 4px;">Active</span>
                        }
                        else
                        {
                            <span class="badge" style="background-color: var(--text-secondary); color: white; padding: 0.25rem 0.5rem; border-radius: 4px;">Completed</span>
                        }
                    </td>
                    <td>
                        <form method="post" asp-action="DeleteRent" asp-route-id="@rent.Id" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-secondary" onclick="return confirm('Are you sure?')">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">Back to Dashboard</a>
