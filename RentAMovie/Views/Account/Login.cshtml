@model RentAMovie.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="page-header">
    <h2>Login</h2>
</div>

<div style="max-width: 400px; margin: 0 auto;">
    <form method="post">
        <div class="mb-3">
            <label class="form-label">Username</label>
            <input asp-for="Username" class="form-control" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <div style="position: relative;">
                <input asp-for="Password" type="password" id="passwordInput" class="form-control" />
                <button type="button" onclick="togglePassword()" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); border: none; background: none; cursor: pointer; font-size: 1.2rem;">
                    👁️
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(false)
            </div>
        }

        <button type="submit" class="btn btn-primary w-100">Login</button>
    </form>

    <p class="mt-3 text-center">
        No account? <a href="/Account/Register" style="color: var(--accent-color);">Register here</a>
    </p>
</div>

<script>
    function togglePassword() {
        const passwordInput = document.getElementById('passwordInput');
        const button = event.target;

        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            button.textContent = '🙈';
        } else {
            passwordInput.type = 'password';
            button.textContent = '👁️';
        }
    }
</script>
